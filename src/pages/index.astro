            </a>

                <a href="/metody/masaz-wroclaw/" class="methods-item" id="masaz">
                <div class="methods-item-title">
                    <img src="/icons/methods-icons/massage-blue.svg" aria-hidden="true">
                    <h3 class="tm-header">Masaż</h3>
                </div>
