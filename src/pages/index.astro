                    <img src="/icons/methods-icons/tm-blue.svg" aria-hidden="true">
                    <h3 class="tm-header">Terapia&nbsp;Manualna</h3>
                </div>
                <p class="methods-item-description">Przywróć naturalną ruchomość</p>
            </a>

                <a href="/metody/terapia-miesniowo-powieziowa-wroclaw/" class="methods-item" id="terapia-miesniowo-powieziowa">
