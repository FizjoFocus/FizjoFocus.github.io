    <section id="metody" class="methods">
        <div class="section-title">
            <h2>Metody&nbsp;pracy</h2>
        </div>
        <p class="subheader">Każdą metodę dobieram indywidualnie do Twojego problemu, aby przywrócić pełną
            sprawność.</p>
        <p class="hint">
            Kliknij nazwę, aby dowiedzieć się więcej →</p>

        <div class="methods-container">
            <a href="/metody/pdtr-wroclaw/" class="methods-item" id="P-DTR">
                <div class="methods-item-title">
                    <img src="/icons/methods-icons/pdtr-blue.svg" aria-hidden="true">
                    <h3 class="pdtr-header">P-DTR</h3>
                </div>
                <p class="methods-item-description">Odblokuj układ nerwowy</p>
            </a>

            <a href="/metody/neuroseminars-wroclaw/" class="methods-item" id="neuro-seminars">
                <div class="methods-item-title">
                    <img src="/icons/methods-icons/neuroseminars-blue.svg" aria-hidden="true">
                    <h3 class="neuroseminars-header">NeuroSeminars</h3>
                </div>
                <p class="methods-item-description">Popraw funkcje mózgu</p>
            </a>

            <a href="/metody/dns-wroclaw/" class="methods-item" id="D-N-S">
                <div class="methods-item-title">
                    <img src="/icons/methods-icons/dns-blue.svg" aria-hidden="true">
