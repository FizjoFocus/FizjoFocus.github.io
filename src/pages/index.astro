                </div>
                <p class="methods-item-description">Odzyskaj harmonię w&nbsp;ciele</p>
            </a>

            <a href="/metody/trening-rehabilitacyjny-wroclaw/" class="methods-item" id="trening-rehabilitacyjny">
                <div class="methods-item-title">
                    <img src="/icons/methods-icons/training-blue.svg" aria-hidden="true">
