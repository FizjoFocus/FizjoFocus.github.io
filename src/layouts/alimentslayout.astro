---
// src/layouts/Layout.astro
import AlimentsHead from '../components/AlimentsHead.astro';
import Nav from '../components/nav.astro';
import AlimentsFooter from '../components/AlimentsFooter.astro';

const { title, description, canonical, schema } = Astro.props;
---

<!DOCTYPE html>
<html lang="pl">
  <head>
    <AlimentsHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body>
    <Nav />

    <main>
      <slot /> </main>

    <AlimentsFooter /> 
    
    <script>
      import '../scripts/main'
      import '../scripts/FAQ'
    </script>
  </body>
</html>