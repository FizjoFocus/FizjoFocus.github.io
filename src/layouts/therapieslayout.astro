---
// src/layouts/Layout.astro
import TherapiesHead from '../components/TherapiesHead.astro';
import Nav from '../components/nav.astro';
import TherapiesFooter from '../components/TherapiesFooter.astro';
import CookieConsent from '../components/CookieConsent.astro';

const { title, description, schema } = Astro.props;
---

<!DOCTYPE html>
<html lang="pl">
  <head>
    <TherapiesHead title={title} description={description} schema={schema} />
  </head>
  <body>
    <Nav />

    <main>
      <slot /> </main>

    <TherapiesFooter /> 
    <CookieConsent />
    
    <script>
      import '../scripts/main'
      import '../scripts/FAQ'
    </script>
  </body>
</html>