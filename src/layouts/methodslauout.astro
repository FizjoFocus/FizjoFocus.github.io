---
// src/layouts/Layout.astro
import MethodHead from '../components/MethodHead.astro';
import Nav from '../components/nav.astro';
import MethodFooter from '../components/MethodFooter.astro';

const { title, description, canonical, schema } = Astro.props;
---

<!DOCTYPE html>
<html lang="pl">
  <head>
    <MethodHead title={title} description={description} canonical={canonical} schema={schema} />
  </head>
  <body>
    <Nav />

    <main>
      <slot /> </main>

    <MethodFooter /> 
    
    <script>
      import '../scripts/main'
    </script>
  </body>
</html>